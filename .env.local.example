# Copy this file to .env.local (gitignored) and fill in your key.

# Free Unsplash API key — powers automatic topic-based photo sourcing
# for devotionals and the homepage hero. Get one in about 2 minutes:
#   1. Create an account at https://unsplash.com/developers
#   2. "New Application" — accept the API terms
#   3. Copy the "Access Key" it gives you
# The free ("demo") tier allows 50 requests/hour, which is far more than
# enough — this project only calls the API when you run `npm run fetch-images`,
# not on every page view.
UNSPLASH_ACCESS_KEY=

# --- Studio (private admin) ---

# NOTE: DATABASE_URL goes in a separate `.env` file (already created for
# you), not here — Prisma's CLI only reads `.env`. Local dev uses SQLite
# out of the box; before deploying, swap `.env`'s DATABASE_URL for a
# hosted Postgres connection string (Neon / Vercel Postgres) — see
# README.md — and update prisma/schema.prisma's provider to "postgresql".

# Used once by `npm run db:seed` to create the first admin account.
# Change the password from Studio > Settings after logging in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-after-first-login

# Signs Studio session cookies — generate your own, don't reuse this:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Web push — lets the public "REMIND ME" button subscribe a browser for
# real. Generate your own pair, don't reuse someone else's:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Authorizes Vercel Cron to call /api/cron/send-notifications, the route
# that actually sends queued email/push (see vercel.json). Generate your
# own, don't reuse this one — and add the same value in Vercel's project
# env vars, since that's what the cron invocation itself needs it to match:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
